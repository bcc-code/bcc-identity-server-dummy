{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "System": "Warning"
      }
    }
  },
  "Client": {
    "Bcc": {
      "Id": "bcc-client",
      "Secret": "bcc-secret",
      "RedirectUri": "https://localhost:5001/signin-oidc",
      "Scopes": [ "openid", "profile", "email", "person#read", "offline_access" ],
      "ResponseType": "code"
    }
  },
  "ApiScopes": {
    "person#read": {
      "Name": "bcc-api",
      "Claims": [ "profile", "email", "openid" ]
    }
  },
  "IdentityResources": {
    "BccIdentity": {
      "Name": "bcc-identity",
      "Claims": [ "profile", "email", "openid" ]
    }
  }
}